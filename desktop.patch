+  min-height: 100vh;
+  margin: 0 auto;
+  padding: 32px clamp(20px, 4vw, 64px) 48px;
+}
+
+.dashboard-header,
+.section-heading {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 20px;
+}
+
+.dashboard-header {
+  margin-bottom: 28px;
+}
+
+h1,
+h2,
+p {
+  margin: 0;
+}
+
+h1 {
+  margin-top: 4px;
+  font-size: clamp(28px, 4vw, 44px);
+  letter-spacing: -0.04em;
+}
+
+h2 {
+  margin-top: 3px;
+  font-size: 22px;
+  letter-spacing: -0.02em;
+}
+
+.eyebrow {
+  color: #8090a3;
+  font-size: 11px;
+  font-weight: 750;
+  letter-spacing: 0.18em;
+}
+
+.header-badges {
+  display: flex;
+  gap: 10px;
+}
+
+.badge {
+  border: 1px solid #28303b;
+  border-radius: 999px;
+  padding: 8px 12px;
+  background: #141922;
+  color: #b9c2ce;
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.badge-online {
+  border-color: rgba(72, 205, 143, 0.35);
+  color: #74dfa9;
+}
+
+.badge-offline {
+  border-color: rgba(232, 105, 112, 0.3);
+  color: #ec8a90;
+}
+
+.dashboard-layout {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 310px;
+  gap: 22px;
+}
+
+.camera-section,
+.control-panel {
+  border: 1px solid #202630;
+  border-radius: 20px;
+  background: rgba(17, 21, 28, 0.92);
+  box-shadow: 0 18px 60px rgba(0, 0, 0, 0.25);
+}
