+:root {
+  color-scheme: dark;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  background: #090c11;
+  color: #f4f7fb;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+body.desktop-client {
+  min-height: 100vh;
+  margin: 0;
+  overflow: auto;
+  background:
+    radial-gradient(circle at 20% -10%, rgba(54, 101, 255, 0.18), transparent 35rem),
+    #090c11;
+}
+
+body.desktop-client a-scene {
+  display: none;
+}
+
+#desktop-dashboard {
+  box-sizing: border-box;
