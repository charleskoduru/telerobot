++"""Native one-channel depth behavior for ACT."""
++
++import torch
++
++from lerobot.configs.types import FeatureType, PolicyFeature
++from lerobot.policies.act.configuration_act import ACTConfig
++from lerobot.policies.act.modeling_act import ACTPolicy
++from lerobot.utils.constants import ACTION, OBS_STATE
++
++
++def test_act_uses_separate_one_channel_depth_backbone():
++    config = ACTConfig(
++        input_features={
++            OBS_STATE: PolicyFeature(type=FeatureType.STATE, shape=(6,)),
++            "observation.images.gripperCam": PolicyFeature(
++                type=FeatureType.VISUAL, shape=(3, 64, 64)
++            ),
++            "observation.images.gripperCam_depth": PolicyFeature(
++                type=FeatureType.VISUAL, shape=(1, 64, 64)
++            ),
++        },
++        output_features={ACTION: PolicyFeature(type=FeatureType.ACTION, shape=(6,))},
++        pretrained_backbone_weights=None,
++        chunk_size=2,
++        n_action_steps=2,
++        use_vae=False,
++        dim_model=32,
++        n_heads=2,
++        dim_feedforward=64,
++        n_encoder_layers=1,
++        n_decoder_layers=1,
++    )
++    policy = ACTPolicy(config)
++
++    assert policy.model.backbone["conv1"].in_channels == 3
++    assert policy.model.depth_backbone["conv1"].in_channels == 1
++    assert policy.model.encoder_visual_modality_embed.num_embeddings == 2
++
++    batch = {
++        OBS_STATE: torch.zeros(1, 6),
++        "observation.images.gripperCam": torch.rand(1, 3, 64, 64),
++        "observation.images.gripperCam_depth": torch.rand(1, 1, 64, 64),
++    }
++    actions = policy.predict_action_chunk(batch)
++    assert actions.shape == (1, 2, 6)
++
++
++def test_act_rejects_visuals_that_are_neither_rgb_nor_depth():
++    config = ACTConfig(
++        input_features={
++            "observation.images.bad": PolicyFeature(
++                type=FeatureType.VISUAL, shape=(2, 64, 64)
++            )
++        },
++        output_features={ACTION: PolicyFeature(type=FeatureType.ACTION, shape=(6,))},
++    )
++    try:
++        config.validate_features()
++    except ValueError as error:
++        assert "one channel" in str(error)
++    else:
++        raise AssertionError("Two-channel ACT visual was accepted")
