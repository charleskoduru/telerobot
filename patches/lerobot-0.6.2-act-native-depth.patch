+    @staticmethod
+    def _build_visual_backbone(
+        config: ACTConfig, in_channels: int
+    ) -> tuple[IntermediateLayerGetter, int]:
+        """Create a ResNet backbone for RGB or one-channel metric depth.
+
+        The depth stem is initialized from the mean of the pretrained RGB stem
+        instead of repeating depth to three channels. The remainder of the
+        network starts from the requested ResNet weights but is fully separate
+        from the RGB backbone and can learn depth-specific filters.
+        """
+        backbone_model = getattr(torchvision.models, config.vision_backbone)(
+            replace_stride_with_dilation=[
+                False,
+                False,
+                config.replace_final_stride_with_dilation,
+            ],
+            weights=config.pretrained_backbone_weights,
+            norm_layer=FrozenBatchNorm2d,
+        )
+        if in_channels == 1:
+            rgb_stem = backbone_model.conv1
+            depth_stem = nn.Conv2d(
+                1,
+                rgb_stem.out_channels,
+                kernel_size=rgb_stem.kernel_size,
+                stride=rgb_stem.stride,
+                padding=rgb_stem.padding,
+                dilation=rgb_stem.dilation,
+                groups=rgb_stem.groups,
+                bias=rgb_stem.bias is not None,
+                padding_mode=rgb_stem.padding_mode,
+            )
+            with torch.no_grad():
+                depth_stem.weight.copy_(rgb_stem.weight.mean(dim=1, keepdim=True))
+                if rgb_stem.bias is not None:
+                    depth_stem.bias.copy_(rgb_stem.bias)
+            backbone_model.conv1 = depth_stem
+        elif in_channels != 3:
+            raise ValueError(f"Unsupported ACT visual channel count: {in_channels}")
+
+        out_channels = backbone_model.fc.in_features
+        backbone = IntermediateLayerGetter(
+            backbone_model,
+            return_layers={"layer4": "feature_map"},
+        )
+        return backbone, out_channels
